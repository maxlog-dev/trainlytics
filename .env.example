# Copy to .env and fill in values
SECRET_KEY=change-me-to-a-long-random-string
# Users: comma-separated name:bcrypt_hash pairs
# Generate hash: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
USERS=alice:$2b$12$placeholder
# Set to true when served over HTTPS so the refresh cookie is marked Secure
# COOKIE_SECURE=true
# Demo login (demo / demo) — local development only, never in production.
# docker-compose.yml already sets it to true and docker-compose.prod.yml forces it to
# false (both override .env); this line only matters when running the backend directly.
# DEMO_USER_ENABLED=true
