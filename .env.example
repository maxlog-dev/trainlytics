# Copy to .env and fill in values
SECRET_KEY=change-me-to-a-long-random-string
# Users: comma-separated name:bcrypt_hash pairs
# Generate hash: python -c "from passlib.hash import bcrypt; print(bcrypt.hash('yourpassword'))"
USERS=alice:$2b$12$placeholder
# Set to true when served over HTTPS so the refresh cookie is marked Secure
# COOKIE_SECURE=true
